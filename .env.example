# Accounts. The app reads profiles in this order:
#   1. ACCOUNTS_FILE  - path to a local JSON file (gitignored), handy for development
#   2. ACCOUNTS_JSON  - the same JSON as one env var (Render: add it as a secret env var)
#   3. the legacy flat variables below (one account, gateway production)
#
# Schema (see README "Accounts"):
# {
#   "accounts": [{
#     "id": "RRQL",
#     "label": "RRQL production",
#     "defaultPropertyId": "CBA",
#     "gateway": "https://adyen-gateway.apaleo.com",   // or https://adyen-gateway.apaleo-staging.com
#     "apaleo": { "clientId": "", "clientSecret": "", "accountId": "RRQL", "subMerchantId": "" },
#     "modes": {
#       "managed": { "apiKey": "adyk_test_...", "clientKey": "test_...", "environment": "TEST", "merchantAccount": "ExampleCOM" },
#       "balance": { "apiKey": "adyk_test_...", "clientKey": "test_...", "environment": "TEST", "store": "ST..." }
#     }
#   }]
# }
ACCOUNTS_FILE=
ACCOUNTS_JSON=

# --- Legacy single-account fallback (used only when both variables above are empty) ---
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=
APALEO_ACCOUNT_ID=RRQL
APALEO_SUBMERCHANT_ID=

# Drop-in (public). Always talks to checkoutshopper-*.adyen.com.
ADYEN_CLIENT_KEY=
ADYEN_ENVIRONMENT=TEST

# Gateway integrator key (adyk_test_... / adyk_live_...).
ADYEN_API_KEY=

# https://adyen-gateway.apaleo.com (default) or https://adyen-gateway.apaleo-staging.com
ADYEN_CHECKOUT_ORIGIN=

# Managed: set ADYEN_MERCHANT_ACCOUNT. Balance: set ADYEN_STORE. Setting both enables both modes.
ADYEN_MERCHANT_ACCOUNT=
ADYEN_STORE=
