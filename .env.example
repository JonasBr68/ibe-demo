# Apaleo (machine-to-machine client on the demo account, typically RRQL)
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=
APALEO_ACCOUNT_ID=RRQL
APALEO_SUBMERCHANT_ID=

# Drop-in (public). Same Adyen merchant as the gateway credential.
ADYEN_CLIENT_KEY=
ADYEN_ENVIRONMENT=TEST

# Gateway mode (default when ADYEN_GATEWAY_API_KEY is set)
ADYEN_CHECKOUT_MODE=gateway
ADYEN_GATEWAY_BASE_URL=https://adyen-gateway.apaleo.com/api/checkout
ADYEN_GATEWAY_API_KEY=
ADYEN_CHECKOUT_VERSION=v71

# Managed / legacy: merchantAccount is authorized as-is.
# Balance Platform: set ADYEN_STORE (Adyen store code); merchantAccount is injected.
ADYEN_MERCHANT_ACCOUNT=
ADYEN_STORE=

# Direct mode only (real Adyen key — do not set this on Render when using the gateway)
# ADYEN_CHECKOUT_MODE=direct
# ADYEN_API_KEY=
