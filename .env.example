# Apaleo (machine-to-machine client on the demo account, typically RRQL)
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=
APALEO_ACCOUNT_ID=RRQL
APALEO_SUBMERCHANT_ID=

# Drop-in (public). Always talks to checkoutshopper-*.adyen.com — do not point this at the gateway.
ADYEN_CLIENT_KEY=
ADYEN_ENVIRONMENT=TEST

# Checkout HTTP key. Real Adyen key (AQE…) or gateway integrator key (adyk_test_… / adyk_live_…).
ADYEN_API_KEY=

# Empty = call Adyen Checkout (https://checkout-test.adyen.com/v71/…).
# Gateway = https://adyen-gateway.apaleo.com  (origin only, no /api/checkout path, no trailing slash)
ADYEN_CHECKOUT_ORIGIN=

# Managed / legacy: merchantAccount is authorized as-is.
# Balance Platform: set ADYEN_STORE (Adyen store code); merchantAccount is injected by the gateway.
ADYEN_MERCHANT_ACCOUNT=
ADYEN_STORE=
